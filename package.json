{
  "name": "short-url",
  "version": "1.0.0",
  "description": "基于 Cloudflare Pages 的短链接服务",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2024-01-01 --kv URL_STORE",
    "deploy": "wrangler pages deploy public",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "keywords": [
    "cloudflare",
    "pages",
    "workers",
    "short-url",
    "url-shortener"
  ],
  "author": "zhiyixn",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
